<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Obsidian void backdrop -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF070A10" android:offset="0" />
                <item android:color="#FF0D1320" android:offset="0.55" />
                <item android:color="#FF151E30" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mint-Cyan terminal glow -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50"
                android:centerY="54"
                android:gradientRadius="68"
                android:type="radial">
                <item android:color="#3634D399" android:offset="0" />
                <item android:color="#1A22D3EE" android:offset="0.55" />
                <item android:color="#00070A10" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bold Obsidian Terminal Console Frame (fills 16..92 cleanly) -->
    <path
        android:pathData="M23,18 H85 A7,7 0 0,1 92,25 V83 A7,7 0 0,1 85,90 H23 A7,7 0 0,1 16,83 V25 A7,7 0 0,1 23,18 Z"
        android:strokeWidth="2.4">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="92"
                android:endY="90"
                android:startX="16"
                android:startY="18"
                android:type="linear">
                <item android:color="#FF121A2A" android:offset="0" />
                <item android:color="#FF080B12" android:offset="1" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="92"
                android:endY="90"
                android:startX="16"
                android:startY="18"
                android:type="linear">
                <item android:color="#CC34D399" android:offset="0" />
                <item android:color="#CC22D3EE" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top console header divider & status dots -->
    <path
        android:fillColor="#FF1A253B"
        android:pathData="M23,19 H85 A6,6 0 0,1 91,25 V33 H17 V25 A6,6 0 0,1 23,19 Z" />
    <path
        android:fillColor="#FFFB7185"
        android:pathData="M26,26 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0" />
    <path
        android:fillColor="#FFFBBF24"
        android:pathData="M35,26 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0" />
    <path
        android:fillColor="#FF34D399"
        android:pathData="M44,26 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0" />

    <!-- Subtle root '#' badge in top-right header -->
    <path
        android:fillColor="#00000000"
        android:pathData="M75.5,22.5 L74.2,29.5 M80.5,22.5 L79.2,29.5 M72.5,24.8 H82 M72,27.4 H81.5"
        android:strokeColor="#FFFBBF24"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />

    <!-- Giant crisp shell prompt '>_ ' -->
    <path
        android:fillColor="#00000000"
        android:pathData="M28,48 L47,61.5 L28,75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="6.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="47"
                android:endY="75"
                android:startX="28"
                android:startY="48"
                android:type="linear">
                <item android:color="#FF34D399" android:offset="0" />
                <item android:color="#FF22D3EE" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing shell cursor block '_' -->
    <path android:pathData="M53,69 H79 A3,3 0 0,1 82,72 V73 A3,3 0 0,1 79,76 H53 A3,3 0 0,1 50,73 V72 A3,3 0 0,1 53,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="82"
                android:endY="76"
                android:startX="50"
                android:startY="69"
                android:type="linear">
                <item android:color="#FF22D3EE" android:offset="0" />
                <item android:color="#FF34D399" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
